# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# Ollama model to call (this project uses Ollama's cloud models by default)
OLLAMA_MODEL=gemma4:31b-cloud
# Local Ollama server URL (cloud models are proxied through your local Ollama app)
OLLAMA_BASE_URL=http://localhost:11434

# Path to the Tesseract OCR executable, used by the pdf_extractor graph.
# Only needed if `tesseract` is not already on PATH (see SETUP.txt section 6).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
